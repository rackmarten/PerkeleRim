<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>PerkeleRim</AssemblyName>
    <RootNamespace>PerkeleRim</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Marek Uncik</Authors>
    <Copyright>Copyright (c) Marek Uncik</Copyright>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Builds against stub assemblies instead of the game's DLLs. Used by CI. -->
    <UseStubs Condition="'$(UseStubs)' == ''">false</UseStubs>
    <!-- Stub builds go to bin/stubs so deploy-local.ps1 never ships them. -->
    <BaseOutputPath Condition="'$(UseStubs)' == 'true'">bin\stubs\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="stubs\**" />
    <Compile Remove="tests\**" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Real build: reference MSCLoader and Unity from the local My Summer Car install. Never copied to output. -->
  <ItemGroup Condition="'$(UseStubs)' != 'true'">
    <Reference Include="MSCLoader" HintPath="$(MscPath)\mysummercar_Data\Managed\MSCLoader.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(MscPath)\mysummercar_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(MscPath)\mysummercar_Data\Managed\0Harmony.dll" Private="false" />
    <Reference Include="PlayMaker" HintPath="$(MscPath)\mysummercar_Data\Managed\PlayMaker.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(MscPath)\mysummercar_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="cInput" HintPath="$(MscPath)\mysummercar_Data\Managed\cInput.dll" Private="false" />
  </ItemGroup>

  <!-- Game code (src/Game) and the hidden-MSC spike (src/Spike) need Unity, PlayMaker, cInput and Harmony,
       which have no stubs. src/Link is Unity-free, builds everywhere, and msc/tests compiles it too. -->
  <PropertyGroup Condition="'$(UseStubs)' != 'true'">
    <DefineConstants>$(DefineConstants);PERKELERIM_GAME;PERKELERIM_SPIKE</DefineConstants>
  </PropertyGroup>

  <!-- CI build: compile against hand-written stubs of the API surface we use (msc/stubs). -->
  <ItemGroup Condition="'$(UseStubs)' == 'true'">
    <Compile Remove="src\Game\**" />
    <Compile Remove="src\Spike\**" />
    <ProjectReference Include="stubs\MSCLoader\MSCLoader.csproj" Private="false" />
  </ItemGroup>

  <Target Name="CheckMscPath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UseStubs)' != 'true'">
    <Error Condition="'$(MscPath)' == ''" Text="MscPath is not set. Copy local.props.example to local.props at the repo root and set your My Summer Car path, or build with -p:UseStubs=true." />
    <Error Condition="!Exists('$(MscPath)\mysummercar_Data\Managed\MSCLoader.dll')" Text="MSCLoader.dll not found under $(MscPath)\mysummercar_Data\Managed. Install MSCLoader (docs/DEV_SETUP.md)." />
  </Target>

</Project>
