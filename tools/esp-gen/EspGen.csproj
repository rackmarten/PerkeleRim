<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates PerkeleRim.esp (the garage near Whiterun) from the player's own Skyrim.esm with Mutagen.
       GPL-3.0 because Mutagen is (see LICENSE here); the rest of the repository stays MIT. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EspGen</AssemblyName>
    <Copyright>Copyright (c) Marek Uncik</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Last line that still targets net8.0. -->
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.53.1" />
  </ItemGroup>

</Project>
