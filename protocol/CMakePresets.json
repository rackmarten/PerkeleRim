{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "tests",
      "displayName": "Protocol tests (Ninja, MSVC, vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tests",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "linux-tests",
      "displayName": "Protocol tests (Ninja, gcc or clang, doctest fetched)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PERKELERIM_FETCH_DOCTEST": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "tests", "configurePreset": "tests" },
    { "name": "linux-tests", "configurePreset": "linux-tests" }
  ],
  "testPresets": [
    { "name": "tests", "configurePreset": "tests", "output": { "outputOnFailure": true } },
    { "name": "linux-tests", "configurePreset": "linux-tests", "output": { "outputOnFailure": true } }
  ]
}
