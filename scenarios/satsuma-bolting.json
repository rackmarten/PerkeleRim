    {"label": "every part off it, so the scenario starts the same whatever MSC had on it", "cmd": "pr.satsuma", "what": "bare", "expect": ["drawn == true"]},
    {"label": "the body held still on its stand", "cmd": "pr.send", "line": "freeze SATSUMA"},
    {"label": "MSC's spanner set, by the car's nose, opened as the use key on its lid does", "cmd": "pr.send", "line": "open spanner set(itemx) top"},
