    {"label": "bolt 1 out", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #1"},
    {"cmd": "wait", "seconds": 1.5},
    {"cmd": "pr.wheel", "notches": -10},
    {"label": "bolt 2 out", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #2"},
    {"cmd": "wait", "seconds": 1.5},
    {"cmd": "pr.wheel", "notches": -10},
    {"label": "bolt 3 out", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #3"},
    {"cmd": "wait", "seconds": 1.5},
    {"cmd": "pr.wheel", "notches": -10},
    {"label": "bolt 4 out", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #4"},
    {"cmd": "wait", "seconds": 1.5},
    {"cmd": "pr.wheel", "notches": -10},
    {"label": "MSC counts its bolts out", "cmd": "wait", "until": "boltsOut == true", "for": "pr.part door_left", "timeout": 5},
