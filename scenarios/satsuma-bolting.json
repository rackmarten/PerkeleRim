// Building the Satsuma the way My Summer Car does it, with nobody at the keys: the left door, the front left wheel and
// the radiator each picked up by MSC's own hand (`fetch <part> eyes` holds the part under the crosshair, a left click
// picks it up), held to its place on the body (`offer <trigger>`: its Assembly FSM counts the part as come in, MSC checks
// the hand and shows its assemble icon, which has to reach Skyrim), clicked on, bolted with MSC's wrench (2 for the tools,
// `wrench` sets the size of the part's bolts as if that spanner were taken out of the spanner set, `look ... BoltPM #n`
// aims at each bolt, crouched, and `pr.wheel 10` turns it all the way in: eight stages, a notch or two spare for one MSC misses as the aim settles), unbolted (`pr.wheel -10`) and taken off again
// with a right click on MSC's disassemble icon. MSC's own state is checked at each step through the probe (`pr.part`:
// MSC's database as Skyrim got it, and whether Skyrim draws the part on the car), and both games are pictured: Skyrim
// with `screenshot`, MSC's own view with `pr.mscshot` (Documents/My Games/PerkeleRim/Screenshots). The Satsuma comes in
// front of Kumpo (`pr.satsuma here`); a bare test car has no suspension under the front left corner, so the wheel's
// setup marks its disc brake fitted in MSC's database (`fsmvar`, the session never saves). The body is held still
// (`freeze`), as on its stand in the garage. It starts by taking every part
// off (`pr.satsuma bare`), so it runs the same on any build of the car, and from a session's start (Kumpo standing).
// scripts/skytest.ps1 run scenarios/satsuma-bolting.json in a running session; MSC's lines (`cmd: fetch:`, `cmd: offer:`,
// `cmd: look:`, `cmd: wrench:`, `cmd: aim: a second on ...`) are in its PerkeleRim_spike.log, `parts:` in output_log.txt
// and PerkeleRim.log.
{
  "name": "satsuma-bolting",
  "steps": [
    {"label": "MSC has Kumpo", "cmd": "pr.msc", "expect": ["msc == true"]},
    {"label": "his hand, not the tools (1)", "cmd": "pr.key", "key": 49},
    {"label": "the Satsuma in front of Kumpo, drawn", "cmd": "pr.satsuma", "what": "here", "expect": ["drawn == true"]},
    {"label": "every part off it, so the scenario starts the same whatever MSC had on it", "cmd": "pr.satsuma", "what": "bare", "expect": ["drawn == true"]},
    {"label": "the body held still, as on its stand", "cmd": "pr.send", "line": "freeze SATSUMA"},
    {"label": "MSC reports the Satsuma's parts", "cmd": "wait", "until": "parts > 100", "for": "pr.part", "timeout": 10},
    {"label": "the left door is off the car", "cmd": "pr.part", "name": "door_left", "expect": ["installed == false", "attached == false"]},
    {"label": "the left door held under Kumpo's crosshair", "cmd": "pr.send", "line": "fetch door left eyes"},
    {"cmd": "wait", "seconds": 1},
    {"label": "a left click picks it up (MSC's hand)", "cmd": "pr.key", "key": 323},
    {"cmd": "wait", "seconds": 1.5},
    {"label": "Kumpo at the left door's place on the car", "cmd": "pr.send", "line": "look trigger_door_left"},
    {"cmd": "wait", "seconds": 1},
    {"label": "the part counted as held into its place", "cmd": "pr.send", "line": "offer trigger_door_left"},
    {"label": "MSC shows its assemble icon, and Skyrim has it", "cmd": "wait", "until": "assemble == true", "for": "pr.lookat", "timeout": 4},
    {"label": "Skyrim's view at the assemble icon", "cmd": "screenshot", "name": "door-assemble", "hud": true},
    {"label": "MSC's view at the assemble icon", "cmd": "pr.mscshot", "name": "bolting-door-assemble"},
    {"label": "a left click puts it on", "cmd": "pr.key", "key": 323},
    {"label": "MSC has it on the car, and Skyrim draws it there", "cmd": "wait", "until": "installed == true", "for": "pr.part door_left", "timeout": 5},
    {"label": "held still again (MSC's own assembly lets the car go when it is done)", "cmd": "pr.send", "line": "freeze SATSUMA"},
    {"label": "Skyrim draws it on the car (the Satsuma's parts are looked for every half second)", "cmd": "wait", "until": "drawnOnCar == true", "for": "pr.part door_left", "timeout": 5},
    {"cmd": "pr.part", "name": "door_left", "expect": ["attached == true", "drawnOnCar == true", "boltsOut == true", "bolts == 4"]},
    {"label": "the tools out (2), crouched (Ctrl)", "cmd": "pr.key", "key": 50},
    {"cmd": "pr.key", "key": 306},
    {"cmd": "wait", "seconds": 1},
    {"label": "the wrench of its bolts", "cmd": "pr.send", "line": "wrench door left(Clone)"},
    {"label": "at bolt 1", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #1"},
    {"cmd": "wait", "seconds": 1.5},
    {"label": "turned all the way in", "cmd": "pr.wheel", "notches": 10},
    {"label": "at bolt 2", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #2"},
    {"cmd": "wait", "seconds": 1.5},
    {"label": "turned all the way in", "cmd": "pr.wheel", "notches": 10},
    {"label": "at bolt 3", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #3"},
    {"cmd": "wait", "seconds": 1.5},
    {"label": "turned all the way in", "cmd": "pr.wheel", "notches": 10},
    {"label": "at bolt 4", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #4"},
    {"cmd": "wait", "seconds": 1.5},
    {"label": "turned all the way in", "cmd": "pr.wheel", "notches": 10},
    {"label": "MSC counts it bolted, every bolt tight", "cmd": "wait", "until": "bolted == true", "for": "pr.part door_left", "timeout": 5},
    {"cmd": "pr.part", "name": "door_left", "expect": ["allTight == true", "stages == 32"]},
    {"label": "Skyrim's view, bolted on", "cmd": "screenshot", "name": "door-bolted", "hud": true},
    {"label": "MSC's view, bolted on", "cmd": "pr.mscshot", "name": "bolting-door-bolted"},
    {"label": "bolt 1 out", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #1"},
    {"cmd": "wait", "seconds": 1.5},
    {"cmd": "pr.wheel", "notches": -10},
    {"label": "bolt 2 out", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #2"},
    {"cmd": "wait", "seconds": 1.5},
    {"cmd": "pr.wheel", "notches": -10},
    {"label": "bolt 3 out", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #3"},
    {"cmd": "wait", "seconds": 1.5},
    {"cmd": "pr.wheel", "notches": -10},
    {"label": "bolt 4 out", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #4"},
    {"cmd": "wait", "seconds": 1.5},
    {"cmd": "pr.wheel", "notches": -10},
    {"label": "MSC counts its bolts out", "cmd": "wait", "until": "boltsOut == true", "for": "pr.part door_left", "timeout": 5},
    {"cmd": "pr.part", "name": "door_left", "expect": ["bolted == false", "installed == true"]},
    {"label": "the hand again (1), standing (Ctrl twice: prone, up)", "cmd": "pr.key", "key": 49},
    {"cmd": "pr.key", "key": 306},
    {"cmd": "wait", "seconds": 0.5},
    {"cmd": "pr.key", "key": 306},
    {"cmd": "wait", "seconds": 1},
    {"label": "Kumpo looks at the part itself", "cmd": "pr.send", "line": "look door left(Clone)$"},
    {"label": "MSC shows its disassemble icon, and Skyrim has it", "cmd": "wait", "until": "disassemble == true", "for": "pr.lookat", "timeout": 6},
    {"label": "Skyrim's view at the disassemble icon", "cmd": "screenshot", "name": "door-disassemble", "hud": true},
    {"label": "MSC's view at the disassemble icon", "cmd": "pr.mscshot", "name": "bolting-door-disassemble"},
    {"label": "a right click takes it off", "cmd": "pr.key", "key": 324},
    {"label": "MSC has it off the car, and Skyrim no longer draws it there", "cmd": "wait", "until": "installed == false", "for": "pr.part door_left", "timeout": 5},
    {"label": "and Skyrim no longer draws it there", "cmd": "wait", "until": "attached == false", "for": "pr.part door_left", "timeout": 5},
    {"cmd": "pr.send", "line": "aim stop"},
