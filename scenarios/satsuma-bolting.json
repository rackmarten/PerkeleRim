// Building the Satsuma in the Skyrim garage the way My Summer Car does it, with nobody at the keys: the left door, the
// front left wheel and the radiator each picked up off its shelf (MSC's `look` stands Kumpo at it, a left click picks it
// up), held to its place on the body on its stand (`look trigger_...`: MSC's assemble icon has to come, in Skyrim too),
// clicked on, bolted with MSC's wrench (2 for the tools, `wrench` sets the size of the part's bolts as if that spanner were
// taken out of the spanner set, `look ... BoltPM #n` aims at each bolt and `pr.wheel 8` turns it all the way in), then
// unbolted (`pr.wheel -8`), and taken off again with a right click on MSC's disassemble icon. MSC's own bolt state is
// checked at each step through the probe (`pr.part`, MSC's database as Skyrim got it), and both games are pictured at
// the assemble icon, bolted and taken off: Skyrim with `screenshot`, MSC's own view with `pr.mscshot` (in
// Documents/My Games/PerkeleRim/Screenshots). Needs the garage (the Satsuma on its stand, its parts on the shelves).
// scripts/skytest.ps1 run scenarios/satsuma-bolting.json in a running session; MSC's lines (`cmd: look:`, `cmd: wrench:`,
// `cmd: aim: a second on ...`) are in its PerkeleRim_spike.log, `parts:` in output_log.txt and PerkeleRim.log.
{
  "name": "satsuma-bolting",
  "steps": [
    { "label": "MSC has Kumpo", "cmd": "pr.msc", "expect": ["msc == true"] },
    { "label": "MSC reports the Satsuma's parts", "cmd": "wait", "until": "parts > 20", "for": "pr.part", "timeout": 10 },
    { "label": "the left door lies off the car", "cmd": "pr.part", "name": "door_left", "expect": ["installed == false", "placed == true"] },

    // The door: picked up, held to its hinges, clicked on.
    { "label": "Kumpo at the door on its shelf", "cmd": "pr.send", "line": "look door left(Clone)" },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "a left click picks it up", "cmd": "pr.key", "key": 323 },
    { "cmd": "wait", "seconds": 1 },
    { "label": "Kumpo holds it to the body's left door opening", "cmd": "pr.send", "line": "look trigger_door_left" },
    { "label": "MSC shows its assemble icon, and Skyrim has it", "cmd": "wait", "until": "assemble == true", "for": "pr.lookat", "timeout": 6 },
    { "label": "Skyrim's view at the assemble icon", "cmd": "screenshot", "name": "door-assemble", "hud": true },
    { "label": "MSC's view at the assemble icon", "cmd": "pr.mscshot", "name": "bolting-door-assemble" },
    { "label": "a left click puts it on", "cmd": "pr.key", "key": 323 },
    { "label": "MSC has the door on the car, no bolt in", "cmd": "wait", "until": "installed == true", "for": "pr.part door_left", "timeout": 5 },
    { "cmd": "pr.part", "name": "door_left", "expect": ["bolted == false", "boltsOut == true", "bolts > 0"] },

    // Bolted with MSC's tools.
    { "label": "the tools out (2)", "cmd": "pr.key", "key": 50 },
    { "label": "the wrench of the door's bolts", "cmd": "pr.send", "line": "wrench door left(Clone)" },
    { "label": "at its first bolt", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #1" },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "turned all the way in", "cmd": "pr.wheel", "notches": 8 },
    { "label": "at its second bolt", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #2" },
    { "cmd": "wait", "seconds": 1.5 },
    { "cmd": "pr.wheel", "notches": 8 },
    { "label": "at its third bolt", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #3" },
    { "cmd": "wait", "seconds": 1.5 },
    { "cmd": "pr.wheel", "notches": 8 },
    { "label": "at its fourth bolt", "cmd": "pr.send", "line": "look door left(Clone) BoltPM #4" },
    { "cmd": "wait", "seconds": 1.5 },
    { "cmd": "pr.wheel", "notches": 8 },
    { "label": "MSC counts the door bolted", "cmd": "wait", "until": "bolted == true", "for": "pr.part door_left", "timeout": 5 },
    { "cmd": "pr.part", "name": "door_left", "expect": ["installed == true", "allTight == true"] },
    { "label": "Skyrim's view, the door bolted on", "cmd": "screenshot", "name": "door-bolted", "hud": true },
    { "label": "MSC's view, the door bolted on", "cmd": "pr.mscshot", "name": "bolting-door-bolted" },

    // Unbolted and taken off again.
    { "cmd": "pr.send", "line": "look door left(Clone) BoltPM #1" },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "turned all the way out", "cmd": "pr.wheel", "notches": -8 },
    { "cmd": "pr.send", "line": "look door left(Clone) BoltPM #2" },
    { "cmd": "wait", "seconds": 1.5 },
    { "cmd": "pr.wheel", "notches": -8 },
    { "cmd": "pr.send", "line": "look door left(Clone) BoltPM #3" },
    { "cmd": "wait", "seconds": 1.5 },
    { "cmd": "pr.wheel", "notches": -8 },
    { "cmd": "pr.send", "line": "look door left(Clone) BoltPM #4" },
    { "cmd": "wait", "seconds": 1.5 },
    { "cmd": "pr.wheel", "notches": -8 },
    { "label": "MSC counts the door's bolts out", "cmd": "wait", "until": "boltsOut == true", "for": "pr.part door_left", "timeout": 5 },
    { "cmd": "pr.part", "name": "door_left", "expect": ["bolted == false", "installed == true"] },
    { "label": "the hand again (1)", "cmd": "pr.key", "key": 49 },
    { "label": "Kumpo looks at the door", "cmd": "pr.send", "line": "look door left(Clone)" },
    { "label": "MSC shows its disassemble icon, and Skyrim has it", "cmd": "wait", "until": "disassemble == true", "for": "pr.lookat", "timeout": 6 },
    { "label": "Skyrim's view at the disassemble icon", "cmd": "screenshot", "name": "door-disassemble", "hud": true },
    { "label": "a right click takes it off", "cmd": "pr.key", "key": 324 },
    { "label": "MSC has the door off the car", "cmd": "wait", "until": "installed == false", "for": "pr.part door_left", "timeout": 5 },
    { "label": "MSC's view, the door off", "cmd": "pr.mscshot", "name": "bolting-door-off" },
    { "cmd": "pr.send", "line": "aim stop" },

    // The front left wheel, the same way (its bolts are its wheel nuts).
    { "label": "the front left wheel's place is empty", "cmd": "pr.part", "name": "wheelfl", "expect": ["installed == false"] },
    { "label": "Kumpo at a wheel on its shelf", "cmd": "pr.send", "line": "look wheel_regula" },
    { "cmd": "wait", "seconds": 1.5 },
    { "cmd": "pr.key", "key": 323 },
    { "cmd": "wait", "seconds": 1 },
    { "label": "held to the front left hub", "cmd": "pr.send", "line": "look TriggerWheelFL" },
    { "cmd": "wait", "until": "assemble == true", "for": "pr.lookat", "timeout": 6 },
    { "cmd": "screenshot", "name": "wheel-assemble", "hud": true },
    { "cmd": "pr.mscshot", "name": "bolting-wheel-assemble" },
    { "cmd": "pr.key", "key": 323 },
    { "label": "MSC has the wheel on", "cmd": "wait", "until": "installed == true", "for": "pr.part wheelfl", "timeout": 5 },
    { "cmd": "pr.key", "key": 50 },
    { "cmd": "pr.send", "line": "wrench wheelFL" },
    { "cmd": "pr.send", "line": "look wheelFL BoltPM #1" },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "a wheel nut turned all the way in", "cmd": "pr.wheel", "notches": 8 },
    { "label": "MSC has one nut tight", "cmd": "pr.part", "name": "wheelfl", "expect": ["boltsTight >= 1"] },
    { "cmd": "screenshot", "name": "wheel-nut", "hud": true },
    { "cmd": "pr.mscshot", "name": "bolting-wheel-nut" },
    { "label": "and out again", "cmd": "pr.wheel", "notches": -8 },
    { "cmd": "wait", "until": "boltsOut == true", "for": "pr.part wheelfl", "timeout": 5 },
    { "cmd": "pr.key", "key": 49 },
    { "cmd": "pr.send", "line": "look wheelFL wheel_regula" },
    { "cmd": "wait", "until": "disassemble == true", "for": "pr.lookat", "timeout": 6 },
    { "cmd": "pr.key", "key": 324 },
    { "label": "MSC has the wheel off", "cmd": "wait", "until": "installed == false", "for": "pr.part wheelfl", "timeout": 5 },
    { "cmd": "pr.send", "line": "aim stop" },

    // The radiator, in the engine bay.
    { "label": "the radiator lies off the car", "cmd": "pr.part", "name": "radiator", "expect": ["installed == false"] },
    { "label": "Kumpo at the radiator on its shelf", "cmd": "pr.send", "line": "look radiator(Clone)" },
    { "cmd": "wait", "seconds": 1.5 },
    { "cmd": "pr.key", "key": 323 },
    { "cmd": "wait", "seconds": 1 },
    { "label": "held into the engine bay", "cmd": "pr.send", "line": "look trigger_radiator" },
    { "cmd": "wait", "until": "assemble == true", "for": "pr.lookat", "timeout": 6 },
    { "cmd": "screenshot", "name": "radiator-assemble", "hud": true },
    { "cmd": "pr.mscshot", "name": "bolting-radiator-assemble" },
    { "cmd": "pr.key", "key": 323 },
    { "label": "MSC has the radiator in", "cmd": "wait", "until": "installed == true", "for": "pr.part radiator", "timeout": 5 },
    { "cmd": "pr.key", "key": 50 },
    { "cmd": "pr.send", "line": "wrench radiator(xxxxx)" },
    { "cmd": "pr.send", "line": "look radiator(xxxxx) BoltPM #1" },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "its bolt turned all the way in", "cmd": "pr.wheel", "notches": 8 },
    { "cmd": "pr.part", "name": "radiator", "expect": ["boltsTight >= 1"] },
    { "cmd": "screenshot", "name": "radiator-bolted", "hud": true },
    { "cmd": "pr.mscshot", "name": "bolting-radiator-bolted" },
    { "cmd": "pr.wheel", "notches": -8 },
    { "cmd": "wait", "until": "boltsOut == true", "for": "pr.part radiator", "timeout": 5 },
    { "cmd": "pr.key", "key": 49 },
    { "cmd": "pr.send", "line": "look radiator(xxxxx)" },
    { "cmd": "wait", "until": "disassemble == true", "for": "pr.lookat", "timeout": 6 },
    { "cmd": "pr.key", "key": 324 },
    { "label": "MSC has the radiator out", "cmd": "wait", "until": "installed == false", "for": "pr.part radiator", "timeout": 5 },
    { "cmd": "pr.send", "line": "aim stop" }
  ]
}
