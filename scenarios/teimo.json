// Teimo at his stall in Riverwood (skse/src/teimo/Teimo.cpp, protocol/cpp/teimo_talk.h): he stands behind his
// makeshift stall drawn as MSC's own Teimo, Kumpo walks up to the counter and Teimo greets him in MSC's voice with a
// caption, turns to face him, makes small talk while he hangs about and answers the middle finger.
// scripts/skytest.ps1 run scenarios/teimo.json in a running session; which line he said is in pr.teimo's answers and
// PerkeleRim.log ("teimo: says ..."), the pictures in its results folder (scenarios/README.md has what to look for).
{
  "name": "teimo",
  "steps": [
    // In front of the stall, Kumpo facing Teimo across the counter.
    { "label": "Skyrim takes Kumpo", "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "label": "Kumpo in front of Teimo's stall, about 9 m out", "cmd": "pr.teimo.front", "distance": 650 },
    { "cmd": "wait", "seconds": 6 },
    { "label": "MSC takes him there", "cmd": "pr.msc", "expect": ["msc == true", "seated == false"] },
    { "label": "a clear day", "cmd": "scene", "presets": "day clear" },
    { "cmd": "wait", "seconds": 4 },
    { "label": "Teimo is there, drawn as MSC's Teimo, quiet so far", "cmd": "pr.teimo",
      "expect": ["loaded == true", "drawn == true", "distance > 400", "lines == 0"] },

    // The stall and Teimo, one paused frame.
    "pause",
    { "label": "the stall from the front, Teimo behind the counter", "cmd": "screenshot", "name": "stall-front",
      "camera": "orbit pr.teimo: yaw=180 distance=650 pitch=12" },
    { "label": "Teimo up close", "cmd": "screenshot", "name": "teimo-close", "camera": "orbit pr.teimo: yaw=180 distance=230 pitch=5" },
    { "label": "the stall from its side, the cart behind", "cmd": "screenshot", "name": "stall-side",
      "camera": "orbit pr.teimo: yaw=110 distance=750 pitch=15" },
    { "label": "the stall from above, the road and the gate beside it", "cmd": "screenshot", "name": "stall-top",
      "camera": "top pr.teimo: distance=2200" },
    "resume",

    // Kumpo walks up to the counter: Teimo greets him and turns to him.
    { "label": "Kumpo walks up to the counter", "cmd": "pr.key", "key": 119, "seconds": 3.5 },
    { "cmd": "wait", "seconds": 1 },
    { "label": "Teimo greets him", "cmd": "pr.teimo", "expect": ["distance < 280", "lines == 1", "lastTopic matches ^(greet|drunk)$", "caption contains Teimo:"] },
    { "label": "the greeting's caption on Kumpo's view", "cmd": "screenshot", "name": "greeting", "hud": true },
    { "label": "Teimo faces Kumpo", "cmd": "screenshot", "name": "teimo-faces-kumpo", "camera": "orbit player yaw=200 distance=420 pitch=15" },

    // He hangs about: small talk.
    { "cmd": "wait", "seconds": 19 },
    { "label": "small talk while Kumpo hangs about", "cmd": "pr.teimo", "expect": ["lines == 2", "lastTopic == chat"] },
    { "label": "the small talk's caption", "cmd": "screenshot", "name": "chat", "hud": true },

    // The middle finger (V): Teimo answers it, over his small talk.
    { "label": "Kumpo gives him the finger", "cmd": "pr.key", "key": 118, "seconds": 1.5 },
    { "cmd": "wait", "seconds": 1 },
    { "label": "Teimo answers the finger", "cmd": "pr.teimo", "expect": ["lines == 3", "lastTopic == finger", "caption contains Teimo:"] },
    { "label": "his answer's caption", "cmd": "screenshot", "name": "finger", "hud": true },
    { "cmd": "scene", "presets": "restore" }
  ]
}
