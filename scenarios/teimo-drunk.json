// Teimo and a drunk Kumpo (protocol/cpp/teimo_talk.h): walking up drunk (MSC's drunk level 2) gets the greeting and then
// a remark on it, as MSC's Teimo does from PlayerDrunk 0.7; walking off after the visit gets his goodbye.
// scripts/skytest.ps1 run scenarios/teimo-drunk.json in a running session; which lines he said are in pr.teimo's answers
// and PerkeleRim.log ("teimo: says ...").
{
  "name": "teimo-drunk",
  "steps": [
    { "label": "Skyrim takes Kumpo", "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "label": "Kumpo in front of Teimo's stall, about 6 m out", "cmd": "pr.teimo.front", "distance": 450 },
    { "label": "Teimo hasn't met him yet", "cmd": "pr.teimo.reset" },
    { "cmd": "wait", "seconds": 5 },
    { "label": "MSC takes him there", "cmd": "pr.msc", "expect": ["msc == true", "seated == false"] },
    { "label": "Kumpo is drunk", "cmd": "pr.send", "line": "drunk 2" },
    { "cmd": "wait", "seconds": 2 },
    { "label": "Kumpo walks up to the counter", "cmd": "pr.key", "key": 119, "seconds": 2.0 },
    { "label": "Teimo greets him", "cmd": "pr.teimo", "expect": ["lines == 1", "lastTopic == greet"] },
    { "cmd": "wait", "seconds": 6 },
    { "label": "and then remarks on the drink", "cmd": "pr.teimo", "expect": ["lines == 2", "lastTopic == drunk", "caption contains Teimo:"] },
    { "label": "the remark's caption", "cmd": "screenshot", "name": "drunk", "hud": true },
    { "cmd": "wait", "seconds": 5 },
    { "label": "Kumpo backs off past 8 m", "cmd": "pr.key", "key": 115, "seconds": 5.0 },
    { "label": "Teimo says goodbye", "cmd": "pr.teimo", "expect": ["lines == 3", "lastTopic == bye"] },
    { "label": "sober again", "cmd": "pr.send", "line": "drunk 0" }
  ]
}
