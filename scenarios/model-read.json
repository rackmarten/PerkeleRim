// MSC's frames while it reads and sends its models (msc/src/Game/ModelSender.cs): every model read again with new ids,
// as after MSC starts ("models again cold"), then read and sent again under the same ids, as after Skyrim restarts
// ("models again"; nothing kept from the cold read: MSC lets go of its textures 5 s after it, pr.models waits 8). MSC logs each stretch's frames ("model: models again cold: ... worst <n> ms"); scripts/model-read-test.ps1
// runs this and prints those lines. The Satsuma is brought first and built with every loose part MSC lets on without bolting, so its parts are read too. Then the
// van, the moped, the Kekmet and the Gifu called one by one and pictured, and the Satsuma,
// to see they still draw right.
{
  "name": "model-read",
  "steps": [
    // Open grass south of the garage's shack, as the other scenarios.
    { "label": "Skyrim takes Kumpo", "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "cmd": "console", "command": "player.setpos x 15700" },
    { "cmd": "console", "command": "player.setpos y -15300" },
    { "cmd": "console", "command": "player.setpos z -4650" },
    { "cmd": "console", "command": "player.setangle z 180" },
    { "cmd": "wait", "seconds": 2 },
    { "label": "MSC takes him there", "cmd": "pr.msc", "expect": ["msc == true", "seated == false"] },

    // The Satsuma on the island, built with every part MSC lets on without bolting, so its body and each part's
    // model are among those read (each part's paint and atlases named by id after the first, v56).
    // Kumpo faces north-east for it, where no vehicle called later parks (the van comes to the south).
    { "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "cmd": "console", "command": "player.setangle z 45" },
    { "cmd": "wait", "seconds": 1 },
    { "cmd": "pr.msc", "expect": ["msc == true", "seated == false"] },
    { "label": "the Satsuma comes", "cmd": "pr.satsuma", "what": "here", "expect": ["drawn == true"] },
    { "label": "every part MSC lets on without bolting goes on", "cmd": "pr.satsuma", "what": "full", "expect": ["attached > 20", "allDrawn == true"] },
    { "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "cmd": "console", "command": "player.setangle z 180" },
    { "cmd": "wait", "seconds": 1 },
    { "cmd": "pr.msc", "expect": ["msc == true", "seated == false"] },

    // As after MSC starts: every model read and sent again, under new ids.
    { "label": "MSC reads every model again", "cmd": "pr.send", "line": "models again cold" },
    { "label": "and sends them", "cmd": "pr.models", "expect": ["chunks > 1000"] },
    // As after Skyrim restarts: read and sent again under the same ids.
    { "label": "MSC sends every model again", "cmd": "pr.send", "line": "models again" },
    { "label": "and they arrive", "cmd": "pr.models", "expect": ["chunks > 1000"] },

    // The vehicles drawn from the models read above, each called in front of Kumpo, a new way each.
    { "label": "a clear day", "cmd": "scene", "presets": "day clear" },
    { "label": "the van comes", "cmd": "pr.call", "vehicle": "van", "expect": ["drawn == true", "solid == true"] },
    { "cmd": "wait", "frames": 30 },
    { "cmd": "screenshot", "name": "van", "camera": "orbit pr.vehicle:van yaw=140 distance=750 pitch=20" },
    { "cmd": "screenshot", "name": "van-back", "camera": "orbit pr.vehicle:van yaw=-40 distance=750 pitch=20" },

    { "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "cmd": "console", "command": "player.setangle z 0" },
    { "cmd": "wait", "seconds": 1 },
    { "cmd": "pr.msc", "expect": ["msc == true", "seated == false"] },
    { "label": "the moped comes", "cmd": "pr.call", "vehicle": "moped", "expect": ["drawn == true", "solid == true"] },
    { "cmd": "wait", "frames": 30 },
    { "cmd": "screenshot", "name": "moped", "camera": "orbit pr.vehicle:moped yaw=220 distance=350 pitch=35" },

    { "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "cmd": "console", "command": "player.setangle z 90" },
    { "cmd": "wait", "seconds": 1 },
    { "cmd": "pr.msc", "expect": ["msc == true", "seated == false"] },
    { "label": "the Kekmet comes (;)", "cmd": "pr.key", "key": 59 },
    { "cmd": "wait", "until": "drawn == true", "for": "pr.vehicle kekmet", "timeout": 30 },
    { "cmd": "wait", "seconds": 3 },
    { "cmd": "screenshot", "name": "kekmet", "camera": "orbit pr.vehicle:kekmet yaw=140 distance=650 pitch=20" },

    { "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "cmd": "console", "command": "player.setangle z 270" },
    { "cmd": "wait", "seconds": 1 },
    { "cmd": "pr.msc", "expect": ["msc == true", "seated == false"] },
    { "label": "the Gifu comes (')", "cmd": "pr.key", "key": 39 },
    { "cmd": "wait", "until": "drawn == true", "for": "pr.vehicle gifu", "timeout": 30 },
    { "cmd": "wait", "seconds": 3 },
    { "cmd": "screenshot", "name": "gifu", "camera": "orbit pr.vehicle:gifu yaw=140 distance=1100 pitch=20" },
    { "cmd": "screenshot", "name": "satsuma", "camera": "orbit pr.vehicle:satsuma yaw=140 distance=600 pitch=20" },
    { "cmd": "screenshot", "name": "all", "camera": "top player distance=2200" },
    { "cmd": "scene", "presets": "restore" }
  ]
}
