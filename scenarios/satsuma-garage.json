// The Satsuma moves over to the garage once (msc/src/Game/GarageMover.cs, skse/src/garage/Garage.cpp, docs/PROTOCOL.md
// "The Satsuma garage"): the session's handover at the garage is the save's first time near the Satsuma bay, so MSC
// moves the body onto its stand and the loose parts from its home onto their shelf slots and the floor. Pictured from
// outside, then saved and loaded again: the load only tells MSC the body lives on its stand (kBayStand), nothing moves
// again, and every part is still on its slot. Then as after MSC restarted (the spike's "garage restart": the parts on
// the island moved as MSC's own save would have them, for an old anchor, and the session's bay forgotten): they're put
// away below rather than left about, and the next handover's stand request lays the bay out again.
// scripts/satsuma-garage-test.ps1 runs it with a fresh MSC save and a half
// built one (PERKELERIM_MSC_SAVE). MSC is closed without saving, so its own save keeps the car at home.
{
  "name": "satsuma-garage",
  "steps": [
    { "cmd": "wait", "seconds": 15 },
    { "label": "the move happened at the handover", "cmd": "pr.garage",
      "expect": ["moved == true", "last.request == 1", "last.body == true", "last.slotted > 40"] },
    { "label": "every part in the bay is on its slot", "cmd": "pr.garage.ask", "what": "check",
      "expect": ["last.missed == 0", "last.slotted > 40"] },
    { "cmd": "pr.vehicle", "vehicle": "satsuma", "expect": ["drawn == true"] },
    { "label": "a clear day", "cmd": "scene", "presets": "day clear" },
    "wait frames=45",
    "pause",
    { "cmd": "screenshot", "name": "bay-front", "camera": "orbit pr.bay: yaw=180 distance=900 pitch=20" },
    { "cmd": "screenshot", "name": "bay-shelves", "camera": "orbit pr.bay: yaw=-90 distance=210 pitch=12" },
    { "cmd": "screenshot", "name": "bay-back", "camera": "orbit pr.bay: yaw=180 distance=210 pitch=12" },
    { "cmd": "screenshot", "name": "bay-top", "camera": "top pr.bay: distance=900 near=620" },
    { "cmd": "screenshot", "name": "body-on-stand", "camera": "orbit pr.vehicle:satsuma yaw=135 distance=230 pitch=20" },
    "resume",

    // A reload never moves anything again.
    { "label": "saved", "cmd": "console", "command": "save PerkeleRimGarageTest" },
    { "cmd": "wait", "seconds": 3 },
    { "label": "loaded again", "cmd": "pr.load", "save": "PerkeleRimGarageTest" },
    { "cmd": "wait", "seconds": 20 },
    { "label": "the load only says where the body lives", "cmd": "pr.garage",
      "expect": ["moved == true", "requests == 1", "last.request == 16", "last.body == true"] },
    { "label": "still every part on its slot", "cmd": "pr.garage.ask", "what": "check",
      "expect": ["last.missed == 0", "last.slotted > 40"] },
    "pause",
    { "cmd": "screenshot", "name": "after-load", "camera": "top pr.bay: distance=900 near=620" },
    "resume",

    // As after an MSC restart with the parts in the bay.
    { "label": "as after an MSC restart", "cmd": "pr.send", "line": "garage restart" },
    { "cmd": "wait", "seconds": 4 },
    { "label": "its stale parts are put away, not left about", "cmd": "pr.garage.ask", "what": "check", "expect": ["last.missed > 40"] },
    { "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "cmd": "wait", "seconds": 3 },
    { "label": "MSC takes him again (a new anchor)", "cmd": "pr.msc", "expect": ["msc == true"] },
    { "cmd": "wait", "seconds": 15 },
    { "label": "the stand request lays the bay out again", "cmd": "pr.garage",
      "expect": ["requests == 2", "last.request == 16", "last.body == true", "last.slotted > 40"] },
    { "label": "every part on its slot again", "cmd": "pr.garage.ask", "what": "check", "expect": ["last.missed == 0", "last.slotted > 40"] },
    { "cmd": "scene", "presets": "restore" }
  ]
}
