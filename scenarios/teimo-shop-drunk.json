// Buying beer drunk at Teimo's stall: MSC's Teimo has lines for a drunk ordering at his bar (tilaus_kanni), and
// says one when Kumpo, at MSC's drunk level 0.7 or more, pays for beer; food bought drunk gets his usual thanks.
// scripts/skytest.ps1 run scenarios/teimo-shop-drunk.json in a running session (after teimo-shop.json, or alone).
{
  "name": "teimo-shop-drunk",
  "steps": [
    { "label": "Skyrim takes Kumpo", "cmd": "pr.msc", "on": false, "expect": "msc == false" },
    { "label": "Kumpo in front of Teimo's stall, about 3 m out", "cmd": "pr.teimo.front", "distance": 220 },
    { "label": "Teimo hasn't met him yet", "cmd": "pr.teimo.reset" },
    { "label": "400 gold", "cmd": "console", "command": "player.removeitem 0000000F 100000" },
    { "cmd": "console", "command": "player.additem 0000000F 400" },
    { "cmd": "wait", "seconds": 4 },
    { "label": "MSC takes him there", "cmd": "pr.msc", "expect": ["msc == true", "seated == false"] },
    { "label": "his hands empty", "cmd": "pr.send", "line": "event DROP_PART" },
    { "cmd": "wait", "seconds": 6 },

    // Sober, food: his thanks.
    { "label": "Kumpo takes sausages", "cmd": "pr.send", "line": "shop take sausages" },
    { "cmd": "wait", "seconds": 1 },
    { "cmd": "pr.send", "line": "shop counter" },
    { "cmd": "wait", "seconds": 2 },
    { "cmd": "pr.teimo", "expect": ["billCount == 1"] },
    { "label": "he pays", "cmd": "pr.teimo.talk" },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "sober: Teimo thanks him", "cmd": "pr.teimo", "expect": ["paid == 1", "lastTopic == paid"] },

    // Drunk, two beer cases at once: two real cases, a drunk-ordering line.
    { "cmd": "wait", "seconds": 4 },
    { "label": "Kumpo is drunk (MSC's drunk level 2)", "cmd": "pr.send", "line": "drunk 2" },
    { "cmd": "wait", "seconds": 3 },
    { "label": "Kumpo takes a beer case", "cmd": "pr.send", "line": "shop take beer" },
    { "cmd": "wait", "seconds": 1 },
    { "cmd": "pr.send", "line": "shop counter" },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "and another", "cmd": "pr.send", "line": "shop take beer" },
    { "cmd": "wait", "seconds": 1 },
    { "cmd": "pr.send", "line": "shop counter" },
    { "cmd": "wait", "seconds": 2 },
    { "cmd": "pr.teimo", "expect": ["billCount == 2", "billTotal ~ 298 +- 0.01"] },
    { "label": "he pays for both", "cmd": "pr.teimo.talk" },
    { "cmd": "wait", "seconds": 1.5 },
    { "label": "drunk, beer: both paid, Teimo's line for a drunk ordering (msc.log: two paid for ..., now beercase<n>, each its own)", "cmd": "pr.teimo",
      "expect": ["paid == 3", "paidTotal ~ 313.09 +- 0.01", "lastTopic == drunkbuy", "caption contains Teimo:"] },
    { "label": "his line's caption", "cmd": "screenshot", "name": "drunk-buy", "hud": true },
    { "label": "sober again", "cmd": "pr.send", "line": "drunk 0" }
  ]
}
